return(function(Parallels, Configurations, Casecade, Library, Others)
    local Components, Settings = { NewTabs = true }, {}

	local Enabled, Options = Parallels.FullOptions()

	local SaveManager = Configurations.Configurations
    local Threads = Parallels.Threads
    
    local JobId = game.JobId

	function Components:Window(Info)
		return Library.Window(Info)
	end

	function Components:Section(Text)
		return Library.Section(Text)
	end

	function Components:MakeTab(Section, Info, Select)
        return Library.Tab(Section, Info, Select)
	end

	function Components:NewPage(Tab, Info)
		return Library.NewPage(Tab, Info)
	end

	function Components:TextLabel(Forms, Info, Mode)
		if Mode == "r" then
			Library.TextLabel(Forms, Info) do
				return Library.RightLabel(Info[3] or "N/A") 
			end
		end

		return Library.TextLabel(Forms, Info).TextLabel
	end

	function Components:Symbol(Forms, Info, Icon)
		return Library.Symbol(Forms, Info, Icon)
	end

	function Components:Toggle(Forms, Info, Flag, UnQueue, Callback)
        local Thread = nil

		return Library.Toggle(Forms, Info, Settings[Flag], function(self, value)
			Settings[Flag] = value
			SaveManager:Save(Flag, value)
			
			if not UnQueue then
				Enabled[Flag] = value

				if value then
					Thread = task.spawn(function()
						if Threads[Flag] then Threads[Flag](Settings[Flag]) end
					end)
				else
					if Thread then task.cancel(Thread) end
				end
			end
			
			if Callback then Callback(value) end
		end)
	end

	function Components:Slider(Forms, Info, Value, Flag, Callback)
		return Library.Slider(Forms, Info, Value[3], { Value[1], Value[2], Settings[Flag] }, function(value)
			Settings[Flag] = value
			SaveManager:Save(Flag, value)

			if Callback then Callback(value) end
		end)
	end

	function Components:Dropdown(Forms, Info, List, Maximum, Flag, Callback)
		return Library.Dropdown(Forms, Info, { List, Maximum, Settings[Flag] }, function(value)
			Settings[Flag] = value
			SaveManager:Save(Flag, value)

			if Callback then Callback(value) end
		end)
	end

	function Components:Button(Forms, Info, Callback, State)
        return Library.Button(Forms, Info, Info[3] or nil, Callback, State)
	end

	function Components:Textfield(Forms, Info, Flag, Callback)
		return Library.Textfield(Forms, Info, Settings[Flag], function(self, value)
			Settings[Flag] = value
			SaveManager:Save(Flag, value)

			if Callback then Callback(value) end
		end)
    end

    return {
        Components = Components,
        Settings = Configurations:Load()
    }
end)

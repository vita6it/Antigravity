return(function(Components, Configurations, Others, Casecade)
    local Plugins = {}
    
    local SaveManager = Configurations.Configurations
    local Settings = Configurations.Settings
    local JobId = game.JobId
    
    function Plugins:Dashboard()
        local Section = Components:Section("Dashboard")

        local Analysis = Components:MakeTab(Section, { "Analysis", 136648496711424 }) do

        end

        local Update = Components:MakeTab(Section, { "Tutorial", 84780130894041 }) do

        end

        return Analysis
    end

    function Plugins:SetValue(index, value)
        Library.app.Window[index] = value
    end

    function Plugins:Managers(set)
        local Section = Components:Section("Managers")

        local Optimize = Components:MakeTab(Section, { "Optimize", 134831414664674 }) do
            local _1 = Components:NewPage(Optimize, { "Optimize", "Allows users to improve performance, efficiency" }) do

                set:Default("White Screen", false)

                Components:Toggle(_1, { "White Screen", "Disabled 3D Rendering to improve performance" }, "White Screen", true, function(value)
                    Others.Optimize:Set3d(value)
                end)

                Components:Button(_1, { "Fast Mode", "Set graphics quality to low", "Boost" }, function()
                    Others.Optimize:Low()
                end)
            end
        end

        local Server = Components:MakeTab(Section, { "Server", 105159951926712 }) do
            local _1 = Components:NewPage(Server, { "Server", "Allows users to join and change to target server." }) do

                set:Default("JobId", JobId)

                Components:Textfield(_1, { "Enter JobId", "Paste the target server JobId to join a specific server instance."  }, "JobId")

                Components:Button(_1, { "Join", "Connect to the server using the provided JobId.", "Join" }, function()
                    Others.Server:Join(Settings['JobId'])
                end)

                Components:Button(_1, {  "Copy JobId", "Copy the current server JobId to your clipboard.", "Copy" }, function()
                    pcall(setclipboard, JobId)
                end)

                Components:Button(_1, { "Change Server", "Teleport to a different public server instance.", "Change" }, function()
                    Others.Server:Change()
                end)

                Components:Button(_1, { "Rejoin Server", "Reconnect to the current server instance.", "Rejoin" }, function()
                    Others.Server:Rejoin()
                end)
            end
        end

        local Appearance = Components:MakeTab(Section, { "Appearance", 92721515638108 }) do
            local _1 = Components:NewPage(Appearance, { "Theme", "Customize the overall look and visual style of the system." }) do

                set:Default("Dark Mode", false)

                Components:Toggle(_1, { "Dark Mode", "Dark Mode is a application appearance setting that uses a dark color palette to provide a comfortable viewing experience tailored for low-light environments." }, "Dark Mode", true, function(value)
                    Library.app['Theme'] = value and Casecade.Themes.Dark or Casecade.Themes.Light
                end)
            end

            local _2 = Components:NewPage(Appearance, { "Input", "Configure input behavior and interaction settings." }) do

                set:Default("Searchable", true)
                set:Default("Draggable", true)
                set:Default("Resizable", true)

                Components:Toggle(_2, { "Searchable", "Allows pages to be searched using a text field in the title bar." }, "Resizable", true, function(value)
                    Plugins:SetValue('Searching', value)
                end)

                Components:Toggle(_2, { "Draggable", "Allows users to move the window with a mouse or touch device." }, "Draggable", true, function(value)
                    Plugins:SetValue('Draggable', value)
                end)

                Components:Toggle(_2, { "Resizable", "Allows users to resize the window with a mouse or touch device." }, "Resizable", true, function(value)
                    Plugins:SetValue('Resizable', value)
                end)
            end

            local _3 = Components:NewPage(Appearance, { "Effects", "These effects may be resource intensive across different systems." }) do

                set:Default("Shadow", true)
                set:Default("Acrylic", false)

                Components:Toggle(_3, { "Shadow", "Enables a dropshadow effect on the window." }, "Shadow", true, function(value)
                    Plugins:SetValue('Dropshadow', value)
                end)

                Components:Toggle(_3, { "Acrylic", "Enables a UI background blur effect on the window." }, "Acrylic", true, function(value)
                    Plugins:SetValue('UIBlur', value)
                end)
            end
        end

        local Configs = Components:MakeTab(Section, { "Configuration", 134261589888025 }) do
            local _1 = Components:NewPage(Configs, { "Configurations", "Manage and customize system configuration settings." }) do
                local Button = Components:Button(_1, { "Remove Worksapce", "Reset save setting file to default value.", "Remove" }, function()
                    local Files = Configurations.FullPaths or SaveManager.FullPaths

                    if Files and isfile(Files) then
                        pcall(delfile, Configurations.FullPaths or SaveManager.FullPaths)
                        warn('Remove Success')
                    else
                        warn('File not found')
                    end
                end, "Destructive")
            end
        end
    end
    
    return Plugins
end)
